# Environment variables for Backend API
PORT=3000
NODE_ENV=development

# Hardhat Network
HARDHAT_NETWORK_URL=http://127.0.0.1:8545
HARDHAT_CHAIN_ID=31337

# Contract Addresses (deployed addresses will go here)
TOURNAMENT_CONTRACT_ADDRESS=0xYourTournamentContractAddressHere

# IPFS Configuration
IPFS_PROJECT_ID=your-ipfs-project-id
IPFS_PROJECT_SECRET=your-ipfs-project-secret

# OAuth/JWT (for authentication)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# Notification Service
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password